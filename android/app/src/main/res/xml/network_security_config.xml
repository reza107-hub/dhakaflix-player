<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP only for known DhakaFlix hosts. Keep in sync with knownHosts in lib/core/source.dart. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.16.50.14</domain>
    </domain-config>
</network-security-config>
